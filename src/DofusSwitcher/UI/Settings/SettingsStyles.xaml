<!-- Styles de la fenêtre des réglages : panneaux, lignes, emplacement « Ajouter un perso », case d'initiative -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:DofusSwitcher.UI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/UI/Theme/Colors.xaml" />
        <ResourceDictionary Source="/UI/Theme/Buttons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Panneau d'une colonne -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <!-- Ligne de réglage : libellé à gauche, contrôle à droite -->
    <Style x:Key="SettingRow" TargetType="DockPanel">
        <Setter Property="Margin" Value="0,5" />
        <Setter Property="LastChildFill" Value="True" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource StrokeBrush}" />
        <Setter Property="Margin" Value="0,14" />
    </Style>

    <!-- Emplacement vide "Ajouter un perso", en pointillés : la place libre dans l'équipe -->
    <Style x:Key="AddSlotButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Height="52" Background="Transparent">
                        <Rectangle x:Name="Dash" RadiusX="9" RadiusY="9" Stroke="#40FFE9C8"
                                   StrokeThickness="1.5" StrokeDashArray="4 3" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dash" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Petite case numérique pour l'initiative (bord rouge si ce n'est pas un nombre) -->
    <Style x:Key="InitiativeBox" TargetType="TextBox">
        <Setter Property="Width" Value="66" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTip" Value="Initiative du perso (fiche de caractéristiques en jeu). Sert à ranger l'équipe dans l'ordre des tours." />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource StrokeBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="4,5">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            <TextBlock x:Name="Placeholder" Text="Init." Visibility="Collapsed" IsHitTestVisible="False"
                                       HorizontalAlignment="Center" FontWeight="Normal" FontStyle="Italic"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasInitiativeError}" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
