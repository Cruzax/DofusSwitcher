<Window x:Class="DofusSwitcher.UI.FloatingBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DofusSwitcher.UI"
        Title="Dofus Switcher"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="SlotButton" TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Poignée de déplacement : verticale en mode horizontal, horizontale en mode vertical -->
        <Style x:Key="Grip" TargetType="Border">
            <Setter Property="Width" Value="14" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ToolTip" Value="Déplacer (clic droit : réglages)" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Layout.IsVertical}" Value="True">
                    <Setter Property="Width" Value="NaN" />
                    <Setter Property="Height" Value="14" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PauseButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#99FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Content" Value="&#xE769;" />
            <Setter Property="ToolTip" Value="Mettre les raccourcis en pause" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <DataTrigger Binding="{Binding Layout.IsVertical}" Value="True">
                    <Setter Property="Width" Value="NaN" />
                    <Setter Property="Height" Value="26" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Content" Value="&#xE768;" />
                    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="ToolTip" Value="En pause : clique pour réactiver les raccourcis" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Mosaïque ⇄ plein écran sans bordure -->
        <Style x:Key="MosaicButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#99FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Content" Value="&#xE8A9;" />
            <Setter Property="ToolTip" Value="Mosaïque : tous les clients sur l'écran" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <DataTrigger Binding="{Binding Layout.IsVertical}" Value="True">
                    <Setter Property="Width" Value="NaN" />
                    <Setter Property="Height" Value="26" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMosaic}" Value="True">
                    <Setter Property="Content" Value="&#xE740;" />
                    <Setter Property="ToolTip" Value="Repasser chaque client en plein écran" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Fermer tous les clients : un 1er clic arme le bouton (rouge), un 2e confirme -->
        <!-- Pas basé sur PauseButton : il hériterait de son apparence "en pause" -->
        <Style x:Key="CloseAllButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#99FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Content" Value="&#xE7E8;" />
            <Setter Property="ToolTip" Value="Fermer tous les clients Dofus" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF" />
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding Layout.IsVertical}" Value="True">
                    <Setter Property="Width" Value="NaN" />
                    <Setter Property="Height" Value="26" />
                    <Setter Property="Margin" Value="0,2,0,0" />
                </DataTrigger>
                <Trigger Property="Tag" Value="Armed">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SlotsList" TargetType="ItemsControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="4"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
        <Border.ContextMenu>
            <ContextMenu Opened="BarMenu_Opened">
                <MenuItem x:Name="PauseMenuItem" Click="Pause_Click" />
                <MenuItem Header="Réglages" Click="Settings_Click" />
                <MenuItem Header="Masquer la barre" Click="HideBar_Click" />
                <Separator />
                <MenuItem Header="Quitter" Click="Quit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel Orientation="{Binding Layout.Orientation}">
            <Border Style="{StaticResource Grip}" MouseLeftButtonDown="Grip_MouseLeftButtonDown">
                <TextBlock Text="⋮⋮" Foreground="#77FFFFFF" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>

            <Button Style="{StaticResource PauseButton}" Click="Pause_Click" />
            <Button Style="{StaticResource MosaicButton}" Click="Mosaic_Click"
                    AutomationProperties.Name="Mosaïque ou plein écran" />

            <TextBlock x:Name="EmptyHint" Text="Clic droit → Réglages pour ajouter tes persos"
                       Foreground="{StaticResource MutedTextBrush}" Margin="8,6,10,6" VerticalAlignment="Center" />

            <ItemsControl x:Name="SlotsList" ItemsSource="{Binding Slots}" Style="{StaticResource SlotsList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="{Binding DataContext.Layout.Orientation, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource SlotButton}" Tag="{Binding}" ToolTip="{Binding ToolTipText}"
                                Click="Slot_Click"
                                PreviewMouseLeftButtonDown="Slot_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="Slot_PreviewMouseMove">
                            <Grid x:Name="Card"
                                  Width="{Binding DataContext.Layout.SlotSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Height="{Binding DataContext.Layout.SlotSize, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ui:ClassBadge Appearance="{Binding Appearance}"
                                               CornerRadius="{Binding DataContext.Layout.Corner, RelativeSource={RelativeSource AncestorType=Window}}"
                                               ImageMargin="{Binding DataContext.Layout.ImageMargin, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Border x:Name="Outline" BorderThickness="2" BorderBrush="#22FFFFFF"
                                        CornerRadius="{Binding DataContext.Layout.Corner, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <!-- Anneau qui pulse quand la fenêtre du perso clignote -->
                                <Border x:Name="AlertRing" BorderThickness="3" BorderBrush="{StaticResource AccentBrush}"
                                        Opacity="0" Visibility="Collapsed"
                                        CornerRadius="{Binding DataContext.Layout.Corner, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#F2B33D" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                                    </Border.Effect>
                                </Border>
                                <!-- Initiative (saisie dans les réglages), en haut à droite -->
                                <Viewbox StretchDirection="DownOnly" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,2,2,0"
                                         Height="{Binding DataContext.Layout.HotkeyFontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static ui:Converters.HotkeyLabelHeight}}"
                                         Visibility="{Binding HasInitiative, Converter={StaticResource BoolToVisibility}}">
                                    <Border Background="#B3000000" CornerRadius="4" Padding="3,0">
                                        <TextBlock Text="{Binding InitiativeText}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                                   FontSize="{Binding DataContext.Layout.HotkeyFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Border>
                                </Viewbox>
                                <!-- Les raccourcis longs (Ctrl+Space…) rétrécissent pour rester dans l'icône -->
                                <Viewbox StretchDirection="DownOnly" VerticalAlignment="Bottom" Margin="2,0,2,3"
                                         Height="{Binding DataContext.Layout.HotkeyFontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static ui:Converters.HotkeyLabelHeight}}"
                                         Visibility="{Binding HasHotkey, Converter={StaticResource BoolToVisibility}}">
                                    <Border Background="#B3000000" CornerRadius="4" Padding="4,0">
                                        <TextBlock Text="{Binding HotkeyText}" FontWeight="SemiBold" Foreground="White"
                                                   FontSize="{Binding DataContext.Layout.HotkeyFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Border>
                                </Viewbox>
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Outline" Property="BorderThickness" Value="3" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.35" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAlerting}" Value="True">
                                <Setter TargetName="AlertRing" Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="PulseStoryboard">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="AlertRing" Storyboard.TargetProperty="Opacity"
                                                             From="0.25" To="1" Duration="0:0:0.6" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button x:Name="CloseAllButton" Style="{StaticResource CloseAllButton}" Click="CloseAll_Click"
                    AutomationProperties.Name="Fermer tous les clients Dofus" />
        </StackPanel>
    </Border>
</Window>
